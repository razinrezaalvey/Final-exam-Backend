APP_NAME=SwiftCourier API

# Set to False in production
DEBUG=False

# SQLite for local dev (default)
DATABASE_URL=sqlite:///./swiftcourier.db

# PostgreSQL for production (uncomment and configure)
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE

# SECURITY: Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
# MUST be at least 32 characters. Keep this secret!
SECRET_KEY=CHANGE_ME_GENERATE_WITH_secrets.token_urlsafe_64

# Token expiry
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS — comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173
